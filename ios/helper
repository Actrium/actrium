#!/bin/bash -eu
#
# Assisted scripts

show_error() {
  echo -e "[$(date +'%Y-%m-%dT%H:%M:%S%z')] \033[31m{$*}\033[0m" >&2
  exit 1
}

# Modify iOS Hard Encoding Configuration in Project (BrowserViewModel Medium counterAppDevPath)
update_ios_config() {
  local viewmodel_file="Actrium/Views/MainContentView/BrowserViewModel.swift"
  
  if [[ ! -f "$viewmodel_file" ]]; then
    show_error "File not found: $viewmodel_file"
  fi
  
  # Absolute path to fetching the root of the item (script directory)
  local project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local abs_path="$project_root/ActriumRuntime/keel-guest-examples/counterapp"
  
  # Verify if the target path exists
  if [[ ! -d "$abs_path" ]]; then
    show_error "Target path does not exist: $abs_path"
  fi
  
  # Use sed Replace counterAppDevPath Value
  sed -i '' "s|let counterAppDevPath = \".*\"|let counterAppDevPath = \"$abs_path\"|g" "$viewmodel_file"
  
  echo "✅ Updated counterAppDevPath Yes: $abs_path"
}

# Modify .xcode.env.local Profile (inNODE_BINARY Path)
update_xcode_env() {
  local env_file=".xcode.env.local"
  local node_path="${1:-$(which node)}"
  
  if [[ ! -f "$node_path" ]]; then
    show_error "Node Executable file does not exist: $node_path"
  fi
  
  # Create a file if it does not exist
  if [[ ! -f "$env_file" ]]; then
    echo "export NODE_BINARY=$node_path" > "$env_file"
    echo "✅ Created $env_file and set up NODE_BINARY=$node_path"
  else
    # Check if there is one. NODE_BINARY Configure
    if grep -q "^export NODE_BINARY=" "$env_file"; then
      sed -i '' "s|^export NODE_BINARY=.*|export NODE_BINARY=$node_path|g" "$env_file"
      echo "✅ Updated NODE_BINARY Yes: $node_path"
    else
      echo "export NODE_BINARY=$node_path" >> "$env_file"
      echo "✅ Added NODE_BINARY=$node_path Present. $env_file"
    fi
  fi
}

# Portable Starter
main() {
  case $1 in
  're') # New installation from RN Reliance library (update configuration)
    # update_ios_config
    # update_xcode_env
    ./Scripts/reinstall-dependencies.sh
    ;;
  
  'config') # Update BrowserViewModel Development path in
    update_ios_config
    ;;
  
  'node') # Update .xcode.env.local Medium Node Path
    shift
    update_xcode_env "$@"
    ;;

  'tf') # Pack and upload to TestFlight
    ./Scripts/upload-testflight.sh
    ;;

  'pkg') # Debug Build
    ./Scripts/test-build.sh pkg
    ;;

  'pkg-prd') # Formal Build
    ./Scripts/test-build.sh pkg-prd
    ;;

  *) show_error "Invalid Command: $*" ;;
  esac
}

main "$@"
