#!/bin/bash

# ==============================================================================
# Actrium Helper Script (af)
# Shortcuts to integrate common build and development commands
# ==============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Colour Output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

usage() {
    echo ""
    echo -e "${BLUE}Actrium Helper (af)${NC}"
    echo ""
    echo "Usage: af <command> [options]"
    echo ""
    echo "Command:"
    echo "  install    Installation Dependence (React Native + CocoaPods)"
    echo "  bundle     Pack up. React Native Bundle"
    echo "  build      Local Test Build (Generate IPA)"
    echo "  check      Check Project Configuration"
    echo "  upload     Build and Upload TestFlight"
    echo "  clean      Clean construction products and caches"
    echo "  help       Show this help information"
    echo ""
    echo "Example::"
    echo "  af install           # Install all dependencies"
    echo "  af bundle            # Pack up. RN Bundle"
    echo "  af build             # Local Test Build (Release)"
    echo "  af build pkg         # Local Test Build (Debug)"
    echo "  af check             # Check Configuration"
    echo "  af upload            # Upload to TestFlight"
    echo "  af clean             # Cleaning of construction products"
    echo ""
}

cmd_install() {
    echo -e "${BLUE}📦 Installation Dependence...${NC}"
    "$SCRIPT_DIR/reinstall-dependencies.sh"
}

cmd_bundle() {
    echo -e "${BLUE}📦 Pack up. React Native Bundle...${NC}"
    "$SCRIPT_DIR/ensure-actrium-runtime.sh"
    cd "$PROJECT_ROOT/ActriumRuntime"

    if [ ! -d "node_modules" ]; then
        echo -e "${YELLOW}⚠️  node_modules No, no, no, no....${NC}"
        if command -v yarn &> /dev/null; then
            yarn install
        elif command -v bun &> /dev/null; then
            bun install
        elif command -v npm &> /dev/null; then
            npm install
        else
            echo -e "${RED}❌ Not found yarn, bun or npm${NC}"
            exit 1
        fi
    fi

    node node_modules/react-native/scripts/bundle.js \
        --platform ios \
        --dev false \
        --entry-file index.ts \
        --bundle-output "$PROJECT_ROOT/Actrium/runtime.jsbundle" \
        --assets-dest "$PROJECT_ROOT/Actrium"

    cd "$PROJECT_ROOT"
    echo -e "${GREEN}✅ React Native Bundle Packing's done.${NC}"
}

cmd_build() {
    local build_type="${1:-pkg-prd}"
    echo -e "${BLUE}🏗️  Local Test Build...${NC}"
    "$SCRIPT_DIR/test-build.sh" "$build_type"
}

cmd_check() {
    echo -e "${BLUE}🔍 Check Project Configuration...${NC}"
    "$SCRIPT_DIR/check-config.sh"
}

cmd_upload() {
    echo -e "${BLUE}☁️  Build and Upload TestFlight...${NC}"
    "$SCRIPT_DIR/upload-testflight.sh"
}

cmd_clean() {
    echo -e "${BLUE}🧹 Clean construction products and caches...${NC}"
    cd "$PROJECT_ROOT"

    rm -rf build
    if [ -d "ActriumRuntime/node_modules" ]; then
        rm -rf ActriumRuntime/node_modules
    fi
    rm -rf Pods

    if command -v watchman &> /dev/null; then
        echo "🧹 Cleaning Watchman Cache..."
        watchman watch-del-all
    fi

    echo -e "${GREEN}✅ Cleanup complete.${NC}"
}

# Main entrance
COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
    install|i)
        cmd_install "$@"
        ;;
    bundle|b)
        cmd_bundle "$@"
        ;;
    build|bd)
        cmd_build "$@"
        ;;
    check|c)
        cmd_check "$@"
        ;;
    upload|u)
        cmd_upload "$@"
        ;;
    clean|cl)
        cmd_clean "$@"
        ;;
    help|h|--help|-h)
        usage
        ;;
    *)
        echo -e "${RED}❌ Unknown command: $COMMAND${NC}"
        usage
        exit 1
        ;;
esac
