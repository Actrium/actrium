{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "preserveSymlinks": true
  },
  "include": ["src/protobuf.ts", "src/unified-app.tsx"],
  "exclude": ["node_modules"]
}
