package actr:spike-async@0.1.0;

// Async functions use the Component Model async ABI explicitly. The host
// drives calls through Store::run_concurrent and Accessor. The harness keeps
// calls on one Store sequential; this is a host policy, not a WIT guarantee.

interface types {
    record actr-id {
        serial-number: u64,
    }

    variant spike-error {
        internal(string),
        timeout(string),
        bad-payload(string),
    }

    record rpc-envelope {
        route-key: string,
        payload: list<u8>,
        request-id: string,
    }
}

// Host imports may suspend without holding a mutable Store borrow.
interface host {
    use types.{actr-id, spike-error};

    // Simulates actr's ctx.call_raw() - real network RPC. Host-side impl
    // will await a tokio::time::sleep.
    call-raw: async func(
        target: actr-id,
        route-key: string,
        payload: list<u8>,
    ) -> result<list<u8>, spike-error>;

    // Logging uses the same explicit async ABI.
    log-message: async func(level: string, msg: string);
}

// Guest-exported workload hooks use the async canonical ABI.
interface workload {
    use types.{rpc-envelope, spike-error};

    on-start: async func() -> result<_, spike-error>;
    dispatch: async func(env: rpc-envelope) -> result<list<u8>, spike-error>;
}

world spike-guest-async {
    import host;
    export workload;
}
