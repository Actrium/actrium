<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Actrium.Windows.Tests</AssemblyName>
    <RootNamespace>Actrium.Windows.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.*" />
    <!-- DPAPI protection for the browser sync credential file; not part of
         the .NET 8 shared framework. Non-Windows test hosts never reach the
         DPAPI calls (the store writes a plain envelope there). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests exercise the real Rust core library: a missing library is a
         test failure, not a silent skip. The dylib glob covers macOS hosts
         running the same suite through verify:windows. -->
    <Content Include="..\native\*.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\native\*.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
