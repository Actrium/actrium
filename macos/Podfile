ACTRO_RUNTIME_RELATIVE_PATH = '../../../packages/actrium'
ACTRO_RUNTIME_PATH = File.expand_path(ACTRO_RUNTIME_RELATIVE_PATH, __dir__)
# Keep react-native-macos path RELATIVE. RN CocoaPods helpers assume `path` is relative and will
# incorrectly prefix it if an absolute path is passed (leading to paths like "./Users/..." or "../Users/...").
REACT_NATIVE_MACOS_PATH = File.join(ACTRO_RUNTIME_RELATIVE_PATH, 'node_modules/react-native-macos')

# Require react_native_pods via a stable absolute path.
require File.join(ACTRO_RUNTIME_PATH, 'node_modules', 'react-native-macos', 'scripts', 'react_native_pods')
require File.join(ACTRO_RUNTIME_PATH, 'node_modules', 'keel', 'scripts', 'keel_post_install')

prepare_react_native_project!

# keel sandbox engine: JSC for guest sandbox (Hermes is main runtime)
ENV['KEEL_SANDBOX_ENGINE'] = 'jsc'

# Shared React Native configuration
def use_actro_react_native
  use_react_native!(
    path: REACT_NATIVE_MACOS_PATH,
    hermes_enabled: true,
    app_path: ACTRO_RUNTIME_PATH
  )

  # keel native sandbox (JSI) - Guest uses JSC engine
  pod 'KeelSandboxNative', :path => File.join(ACTRO_RUNTIME_RELATIVE_PATH, 'node_modules/keel')
end

target 'Actro' do
  platform :macos, '14.0'
end

target 'ActroTests' do
  platform :macos, '14.0'
  use_actro_react_native
end

# Homogeneous browser-style Renderer Helper with React Native
target 'ActroRenderer' do
  platform :macos, '14.0'
  use_actro_react_native
end

post_install do |installer|
  # Tell React Native Right source position. Avoid. Codegen Misreporting
  react_native_post_install(installer, REACT_NATIVE_MACOS_PATH)
  keel_post_install(installer, react_native_path: REACT_NATIVE_MACOS_PATH)

  # NOTE: hermes.framework embedding for ActroViewService XPC target is done via
  # a manually-added build phase in Actro.xcodeproj (not via CocoaPods).
  # CocoaPods' xcodeproj gem doesn't support Xcode 26's PBXFileSystemSynchronizedRootGroup,
  # so we can't programmatically modify the user project from post_install.

  # Inhibit All Pods Warning for items
  installer.pods_project.targets.each do |target|
    target.shell_script_build_phases.each do |phase|
      case phase.name
      when '[CP-User] [Hermes] Replace Hermes for the right configuration, if needed'
        phase.output_paths = ['$(DERIVED_FILE_DIR)/hermes-replace-version-$(CONFIGURATION).stamp']
        phase.shell_script = "#{phase.shell_script}\nmkdir -p \"${DERIVED_FILE_DIR}\"\ntouch \"${SCRIPT_OUTPUT_FILE_0}\"\n"
      when '[CP-User] [RN]Check FBReactNativeSpec'
        phase.output_paths = ['$(DERIVED_FILE_DIR)/check-fbreactnativespec-$(CONFIGURATION).stamp']
        phase.shell_script = "#{phase.shell_script}\nmkdir -p \"${DERIVED_FILE_DIR}\"\ntouch \"${SCRIPT_OUTPUT_FILE_0}\"\n"
        phase.always_out_of_date = nil if phase.respond_to?(:always_out_of_date=)
      end
    end

    target.build_configurations.each do |config|
      # Ensure REACT_NATIVE_PATH is available in shell script phases.
      # hermes-engine's "[Hermes] Replace Hermes" script references this var
      # but project-level build settings may not propagate to shell environments.
      config.build_settings['REACT_NATIVE_PATH'] ||=
        "${PODS_ROOT}/../#{REACT_NATIVE_MACOS_PATH}"

      # Depress all warnings
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      # Cursing a specific common warning
      config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
      config.build_settings['CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF'] = 'NO'
      config.build_settings['GCC_WARN_64_TO_32_BIT_CONVERSION'] = 'NO'

      # Xcode 17's Apple Clang rejects fmt 11's C++20 consteval formatting path.
      # Keep fmt on C++17 so the library's own feature detection avoids consteval.
      if target.name == 'fmt'
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end

      # 🔥 Disable Hermes/Inspector debugger To avoid a wiring conflict at startup.
      # react_native_post_install Yes. Debug Configure Add HERMES_ENABLE_DEBUGGER=1 and
      # REACT_NATIVE_DEBUGGER_ENABLED=1It's gonna lead to... jsinspector-modern It's... ReentrancyCheck
      # Breaking of the cross-line access was detected on startup. Remove these macros to disable inspector- Don't break down.
      # Note: This will be disabled React Native DevTools , without prejudice to the application of normal operations.
      if config.name == 'Debug'
        debugger_targets = ['React-hermes', 'hermes-engine', 'React-RuntimeHermes', 'React-jsinspector']
        if debugger_targets.include?(target.name)
          defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          defs = defs.reject { |d| d.include?('HERMES_ENABLE_DEBUGGER') || d.include?('REACT_NATIVE_DEBUGGER_ENABLED') }
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
        end
      end
    end
  end
end
