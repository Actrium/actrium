# loran-deploy optional defaults.
#
# NOTE: not yet auto-loaded. CLI flags and environment variables
# (LORAN_REPOSITORY, GITHUB_TOKEN, LORAN_HEALTH_WAIT_SECONDS) are
# authoritative today; this file documents the intended future shape.

repository = "Actrium/actrium"
install_dir = "/opt/loran"
service_name = "loran"
config_path = "/etc/loran/config.toml"
user = "loran"
group = "loran"
health_wait_seconds = 5
