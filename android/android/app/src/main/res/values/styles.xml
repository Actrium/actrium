<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Set statusbar background transparent -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Statusbar text colour (Black text) -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash Screen Theme: Background aligned with application first screen, icons transparent, visual unsensible -->
    <style name="Theme.App.Starting" parent="AppTheme">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>

</resources>
