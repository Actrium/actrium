<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Translucent background mask -->
    <View
        android:id="@+id/vMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <!-- The window contents container. You can add your own contents here. -->
    <io.actrium.app.view.RoundedCornerLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="600dp"
        android:layout_height="600dp"
        android:layout_gravity="center"
        app:cornerRadius="20dp">

        <FrameLayout
            android:id="@+id/llContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </io.actrium.app.view.RoundedCornerLayout>
</FrameLayout>
