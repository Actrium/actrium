{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "keel/guest": ["../../../keel/src/guest/let/index.ts"],
      "askit": ["../../../askit/src/index.guest.ts"]
    }
  },
  "include": ["src/**/*", "../../src/runtime-host/main"],
  "exclude": ["**/node_modules/**"]
}
