// actr workload contract — Component Model WIT, lane-aware async world
//
// `actr:workload@0.8.0` replaces the numeric Realm and embedded Actor type
// with a Realm name and a separately carried Publisher/program identity. These
// record changes break 0.7.0 components; rebuild them with the current SDK.
//
// `actr:workload@0.6.0` extends the 0.5.0 contract with the EXPLICIT reply
// boundary: `invocation-ctx` carries `expects-response` / `reply-enabled`, and
// the host interface adds `reply`, `reply-error`, `reply-sync`, and `reply-error-sync`.
// Changing a record shape and adding required imports both break already-built
// 0.5.0 components, hence the version bump; the host rejects them at load with
// an actionable rebuild hint.
//
// `actr:workload@0.5.0` extends the lane-aware 0.4.0 contract with the
// unified WebRTC peer-state export (`on-webrtc-state-changed`) carried by
// the RTC implementation. Adding a required guest export is a contract break
// for already-compiled packages, hence the version bump; the host rejects
// pre-0.5.0 worlds at load with an actionable rebuild hint.
//
// `actr:workload@0.4.0` extends the timeout-aware 0.3.0 contract with an
// explicit `payload-type` argument on the `call` / `tell` / `call-raw` host
// imports, so a guest's typed RPC calls travel on the lane declared via
// `(actr.payload_type)` in the protobuf schema instead of the host-chosen
// default lane.
//
// `actr:workload@0.3.0` extends the run_concurrent-ready 0.2.0 contract with
// explicit per-call timeout arguments. The async design is a controlled fork
// of the retired `actr:workload@0.1.0` contract that turns transport host
// imports and workload exports into real WIT `async func`s. That single change
// is what unlocks wasmtime 46's Component
// Model Concurrency: multiple `dispatch` calls may be IN FLIGHT on one
// component instance, cooperatively interleaving at each host-import `.await`.
//
// Design decisions (locked in during the Phase 0.75 run_concurrent spike,
// see examples/actr/experimental/component-spike-runconcurrent/REPORT.md):
//
// 1. Transport host imports and workload exports are real WIT `async func`s.
//    This is the shape that unlocks wasmtime 46's Component Model Concurrency:
//    it emits Accessor-based host bindings (static trait methods taking
//    `&Accessor<T, Self>` rather than `&mut self`) and `call_*(accessor, ...)`
//    for the exports, driven by `Store::run_concurrent`. The two `reply-sync`
//    imports below are deliberate synchronous exceptions used only by the
//    Rust `Reply<T>` handle; they enqueue an outcome and do not perform
//    transport I/O. wit-bindgen 0.58 auto-generates async guest bindings from
//    `async func` — no `async: true` flag needed.
//
// 2. Per-call context is carried EXPLICITLY, not via getter imports. The
//    0.1.0 contract exposed `get-self-id` / `get-caller-id` /
//    `get-request-id` imports that read a single per-instance context slot on
//    the host. Under N concurrently in-flight dispatches on one instance that
//    single slot necessarily cross-talks (task A's getter reads task B's slot).
//    v2 removes those three getters and instead threads the identity triple
//    plus a `ctx-token` through each fallible/dispatch export as an explicit
//    `invocation-ctx` record; the SDK answers `ctx.self_id()` etc. locally.
//
// 3. Every host import takes a `ctx-token: u64` first parameter. Every guest
//    export, including the thirteen infallible observation hooks, receives a
//    complete `invocation-ctx`. Its token keys the host's per-invocation table
//    (`HostState.invocations`), letting the host recover the correct
//    `HostAbiFn` / `InvocationContext` for the calling task even when several
//    are interleaved on one instance.
//
// Type naming: WIT kebab-case with a prefix to avoid colliding with
// stdlib-ish names during binding generation (e.g. `actr-error` rather
// than bare `error`, which clashes with `wasi:io/error`).

package actr:workload@0.8.0;

// ─────────────────────────────────────────────────────────────────────────
// Shared value types
// ─────────────────────────────────────────────────────────────────────────
//
// Copied verbatim from 0.1.0 (no semantic change) plus the new
// `invocation-ctx` record used by the dispatch / lifecycle / data-chunk
// exports.

interface types {
    // Three-part actor type coordinate (publisher, name, semantic
    // version string). Mirrors actr_protocol::ActrType.
    record actr-type {
        publisher: string,
        name: string,
        version: string,
    }

    // Actor identity — the Component Model analogue of
    // actr_protocol::ActrId. `realm` is the Realm name
    // `<realm_id>@<domain>`; the Actor type is not part of the identity.
    record actr-id {
        realm: string,
        serial-number: u64,
    }

    // Dispatch destination for host-routed calls (the Component Model
    // analogue of actr_framework::Dest encoded via guest abi::DestV1).
    variant dest {
        // Deliver to this node's host side (the process embedding the workload).
        host,
        // Deliver to this node's workload (self when sent from the workload).
        workload,
        // Deliver to the named remote peer.
        peer(actr-id),
    }

    // RPC envelope (mirrors actr_protocol::RpcEnvelope). The payload is
    // emitted/consumed as `list<u8>` to keep the canonical ABI
    // representation independent of downstream prost message types.
    record rpc-envelope {
        request-id: string,
        route-key: string,
        payload: list<u8>,
        // Request deadline in milliseconds. Responses and tell messages use
        // zero, matching actr_protocol::RpcEnvelope::timeout_ms semantics.
        timeout-ms: s64,
    }

    record metadata-entry {
        key: string,
        value: string,
    }

    record data-chunk {
        stream-id: string,
        sequence: u64,
        payload: list<u8>,
        metadata: list<metadata-entry>,
        timestamp-ms: option<s64>,
    }

    variant payload-type {
        rpc-reliable,
        rpc-signal,
        stream-reliable,
        stream-latency-first,
        media-rtp,
    }

    // Coarse error classification — one-to-one with
    // `actr_framework::ErrorCategory`.
    variant error-category {
        handler-panic,
        handler-error,
        signaling-failure,
        transport-failure,
        data-chunk-delivery-uncertain,
    }

    // Coarse WebRTC send-readiness state — one-to-one with
    // `actr_framework::WebRtcPeerStatus`. Carried by `peer-event.status`
    // so guests can distinguish an initial connection attempt, an active
    // connection, and a recovery window from a terminal teardown.
    variant webrtc-peer-status {
        idle,
        connecting,
        connected,
        recovering,
    }

    // Stable reason a WebRTC peer is unavailable — one-to-one with
    // `actr_framework::WebRtcUnavailableReason`. Carried by
    // `webrtc-peer-state.unavailable-reason` so guests react to terminal or
    // recoverable unavailability without parsing error strings.
    variant webrtc-unavailable-reason {
        connection-not-ready,
        peer-connection-build-failed,
        negotiation-failed,
        ice-restart-failed,
        peer-connection-rebuild-failed,
        unsupported-rtc-capability,
        rtc-resource-limit-exceeded,
        recovery-exhausted,
        closed,
    }

    // Whether the selected ICE candidate pair is direct or relayed —
    // one-to-one with `actr_framework::WebRtcNetworkPath`. `unknown` until
    // stats resolve the selected pair; never blocks `sendable`.
    variant webrtc-network-path {
        unknown,
        direct,
        relayed,
    }

    // Point-in-time unified WebRTC peer state — one-to-one with
    // `actr_framework::WebRtcPeerState`, carried by `on-webrtc-state-changed`.
    // `revision` is monotonic per peer so guests can de-duplicate;
    // `pc-generation` bumps on every hard-recovery rebuild. The latest value
    // is replayed immediately to new subscribers.
    record webrtc-peer-state {
        peer: actr-id,
        pc-generation: u64,
        revision: u64,
        status: webrtc-peer-status,
        sendable: bool,
        network-path: webrtc-network-path,
        relayed: option<bool>,
        unavailable-reason: option<webrtc-unavailable-reason>,
    }

    // Structured error — one-to-one with `actr_protocol::ActrError`.
    //
    // Closed variant mirroring the Rust enum's shape; any future addition
    // to `ActrError` needs a matched addition here (and a version bump
    // on the WIT package). The `dependency-not-found` case carries the
    // two-field record so hosts that translate back into
    // `ActrError::DependencyNotFound` don't lose structure.
    variant actr-error {
        unavailable(string),
        connection-not-ready(connection-not-ready-info),
        timed-out,
        not-found(string),
        permission-denied(string),
        invalid-argument(string),
        unknown-route(string),
        dependency-not-found(dependency-not-found-payload),
        decode-failure(string),
        not-implemented(string),
        internal(string),
        // RFC-0507: the framework cannot prove whether the send entered the
        // transport; terminal for generic retry. Carries the caller-visible
        // operation id so binding consumers can correlate with their own
        // idempotency records. Appended (not interleaved) to keep the
        // discriminant order of the closed 0.6.0 variant stable.
        delivery-uncertain(delivery-uncertain-payload),
    }

    // Payload for the `dependency-not-found` arm.
    record dependency-not-found-payload {
        service-name: string,
        message: string,
    }

    // Payload for the `delivery-uncertain` arm.
    record delivery-uncertain-payload {
        operation-id: string,
        cause: string,
    }

    // Send preflight failure payload. The operation did not enter transport.
    record connection-not-ready-info {
        retry-after-ms: option<u64>,
    }

    // Peer-scoped event (actr_framework::PeerEvent) carried by the
    // WebSocket / WebRTC transport hooks. `relayed` is Some(true) when a
    // WebRTC connection traverses TURN, Some(false) for a direct P2P
    // connection, None for WebSocket events. `status` is the coarse
    // WebRTC send-readiness state; None for WebSocket events.
    record peer-event {
        peer: actr-id,
        relayed: option<bool>,
        status: option<webrtc-peer-status>,
    }

    // Wall-clock timestamp represented as "whole seconds + nanoseconds"
    // since the Unix epoch. WIT has no native timestamp type; this
    // mirrors the SystemTime serialisation used by the rest of actr.
    record timestamp {
        seconds: u64,
        nanoseconds: u32,
    }

    // Dispatch-boundary error event (actr_framework::ErrorEvent).
    record error-event {
        source: actr-error,
        category: error-category,
        context: string,
        timestamp: timestamp,
    }

    // Credential lifecycle event (actr_framework::CredentialEvent).
    record credential-event {
        new-expiry: timestamp,
    }

    // Mailbox backpressure event (actr_framework::BackpressureEvent).
    record backpressure-event {
        queue-len: u64,
        threshold: u64,
    }

    // ── Per-invocation context (v2) ──────────────────────────────────────
    //
    // Carries the identity triple that the 0.1.0 world exposed through the
    // `get-self-id` / `get-caller-id` / `get-request-id` getters, plus the
    // `ctx-token` that keys the host's per-invocation table. Threaded as an
    // explicit parameter through every export so several concurrently
    // in-flight invocations on one instance never cross-read a shared context
    // slot. `self-id` is an instance constant; `caller-id` is None for
    // host-originated lifecycle and observation hooks; `request-id` identifies
    // the originating operation.
    record invocation-ctx {
        ctx-token: u64,
        self-id: actr-id,
        caller-id: option<actr-id>,
        request-id: string,
        expects-response: bool,
        // Whether this invocation is connected to the host reply boundary.
        // Low-level host tests may call the guest export directly and keep
        // the legacy returned-bytes contract instead.
        reply-enabled: bool,
    }
}

// ─────────────────────────────────────────────────────────────────────────
// Host imports — guest->host surface
// ─────────────────────────────────────────────────────────────────────────
//
// Corresponds to the HostCallV1 / HostTellV1 / HostCallRawV1 /
// HostDiscoverV1 operations routed through the host ABI bridge. Transport
// imports are real `async func`s (so wasmtime 46 emits the Accessor-based,
// static host trait) and take a `ctx-token: u64` first parameter identifying
// the calling invocation, which the host uses to recover the correct
// `HostAbiFn` even when multiple invocations interleave on one instance. The
// two synchronous `reply-sync` imports only enqueue Rust `Reply<T>` outcomes.

interface host {
    use types.{actr-id, actr-type, actr-error, data-chunk, dest, payload-type};

    // Typed-routed call: host forwards to the destination on the requested
    // payload-type lane, returning the encoded response payload.
    call: async func(
        ctx-token: u64,
        target: dest,
        route-key: string,
        payload: list<u8>,
        timeout-ms: s64,
        payload-type: payload-type,
    ) -> result<list<u8>, actr-error>;

    // Fire-and-forget: host forwards the message on the requested
    // payload-type lane and returns without waiting for a response.
    tell: async func(
        ctx-token: u64,
        target: dest,
        route-key: string,
        payload: list<u8>,
        payload-type: payload-type,
    ) -> result<_, actr-error>;

    // Raw RPC against a known actor identity (no Dest routing).
    call-raw: async func(
        ctx-token: u64,
        target: actr-id,
        route-key: string,
        payload: list<u8>,
        timeout-ms: s64,
        payload-type: payload-type,
    ) -> result<list<u8>, actr-error>;

    // Deliver a response through the current inbound invocation boundary.
    reply: async func(ctx-token: u64, payload: list<u8>) -> result<_, actr-error>;
    reply-error: async func(ctx-token: u64, error: actr-error) -> result<_, actr-error>;

    // Synchronous reply bridge used by the Rust guest Reply<T> handle. The
    // host only enqueues the response here; transport delivery remains
    // asynchronous on the host side. Whether to emit a RESPONSE is derived
    // from the host-owned invocation context, never trusted to the guest.
    reply-sync: func(
        ctx-token: u64,
        payload: list<u8>,
    ) -> result<_, actr-error>;
    reply-error-sync: func(
        ctx-token: u64,
        error: actr-error,
    ) -> result<_, actr-error>;

    // Discovery: find a candidate actor serving the requested type.
    discover: async func(ctx-token: u64, target-type: actr-type) -> result<actr-id, actr-error>;

    // Resolve a declared dependency alias to its canonical actor type.
    resolve-dependency: async func(ctx-token: u64, alias: string) -> result<actr-type, actr-error>;

    register-stream: async func(ctx-token: u64, stream-id: string) -> result<_, actr-error>;

    unregister-stream: async func(ctx-token: u64, stream-id: string) -> result<_, actr-error>;

    send-data-chunk: async func(
        ctx-token: u64,
        target: dest,
        chunk: data-chunk,
        payload-type: payload-type,
    ) -> result<_, actr-error>;

    // Structured log sink. Host-side maps `level` to tracing log levels.
    log-message: async func(ctx-token: u64, level: string, message: string);
}

// ─────────────────────────────────────────────────────────────────────────
// Workload exports — the guest-implemented surface
// ─────────────────────────────────────────────────────────────────────────
//
// One `dispatch` entry that takes an RpcEnvelope and returns the reply
// bytes, plus the seventeen observation hooks from
// actr_framework::Workload. Every export is a real `async func`. The four
// lifecycle hooks and `on-data-chunk` are fallible; `dispatch`,
// `on-data-chunk`, and the four lifecycle hooks additionally take an
// `invocation-ctx` so the guest SDK can answer `ctx.self_id()` /
// `caller_id()` / `request_id()` locally and carry the `ctx-token` into
// host imports. The thirteen infallible observation hooks receive the same
// complete context so identity semantics match linked and dynclib workloads.

interface workload {
    use types.{
        rpc-envelope,
        actr-error,
        actr-id,
        data-chunk,
        peer-event,
        webrtc-peer-state,
        error-event,
        credential-event,
        backpressure-event,
        invocation-ctx,
    };

    // ── Inbound RPC dispatch ─────────────────────────────────────────────

    // Single-entry dispatch for RPC envelopes (Workload::Dispatcher).
    // Returns the response bytes on success, or an error variant that the
    // host translates back into actr_protocol::ActrError.
    dispatch: async func(envelope: rpc-envelope, ctx: invocation-ctx) -> result<list<u8>, actr-error>;

    // ── Lifecycle (4, fallible) ──────────────────────────────────────────

    on-start: async func(ctx: invocation-ctx) -> result<_, actr-error>;
    on-ready: async func(ctx: invocation-ctx) -> result<_, actr-error>;
    on-stop: async func(ctx: invocation-ctx) -> result<_, actr-error>;
    on-error: async func(event: error-event, ctx: invocation-ctx) -> result<_, actr-error>;

    // ── Signaling (3, infallible) ────────────────────────────────────────

    on-signaling-connecting: async func(ctx: invocation-ctx);
    on-signaling-connected: async func(ctx: invocation-ctx);
    on-signaling-disconnected: async func(ctx: invocation-ctx);

    // ── Transport: WebSocket (3, infallible) ─────────────────────────────

    on-websocket-connecting: async func(event: peer-event, ctx: invocation-ctx);
    on-websocket-connected: async func(event: peer-event, ctx: invocation-ctx);
    on-websocket-disconnected: async func(event: peer-event, ctx: invocation-ctx);

    // ── Transport: WebRTC P2P (3, infallible) ────────────────────────────

    on-webrtc-connecting: async func(event: peer-event, ctx: invocation-ctx);
    on-webrtc-connected: async func(event: peer-event, ctx: invocation-ctx);
    on-webrtc-disconnected: async func(event: peer-event, ctx: invocation-ctx);

    // ── Transport: WebRTC unified state (1, infallible, 0.5.0) ───────────

    // Unified per-peer state hook fed by the RTC implementation: carries the
    // full `webrtc-peer-state` snapshot on every transition, subsuming the
    // connecting/connected/disconnected triple for state-machine consumers.
    on-webrtc-state-changed: async func(event: webrtc-peer-state, ctx: invocation-ctx);

    // ── Credential (2, infallible) ───────────────────────────────────────

    on-credential-renewed: async func(event: credential-event, ctx: invocation-ctx);
    on-credential-expiring: async func(event: credential-event, ctx: invocation-ctx);

    // ── Mailbox (1, infallible) ──────────────────────────────────────────

    on-mailbox-backpressure: async func(event: backpressure-event, ctx: invocation-ctx);

    // ── Fast path: DataChunk ────────────────────────────────────────────

    on-data-chunk: async func(chunk: data-chunk, sender: actr-id, ctx: invocation-ctx) -> result<_, actr-error>;
}

// ─────────────────────────────────────────────────────────────────────────
// World — single-world embedding used by both host bindgen! and guest
// wit-bindgen. Host imports are imported by the guest; guest exports are
// imported by the host (via the generated `ActrWorkloadGuestV2::call_*`
// family). Because every function is `async func`, wasmtime 46 emits the
// Accessor-based host trait and `run_concurrent`-driven export calls.
// ─────────────────────────────────────────────────────────────────────────

world actr-workload-guest-v2 {
    import host;
    export workload;
}
