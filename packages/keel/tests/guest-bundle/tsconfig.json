{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["react"],
    "baseUrl": ".",
    "paths": {
      "keel/guest": ["../../src/sdk/index.ts"],
      "keel/contract": ["../../src/contract/index.ts"],
      "keel/*": ["../../src/*"]
    }
  },
  // KNOWN COVERAGE BOUNDARY — a green `check:guest-types` does NOT mean the whole
  // guest type surface is green. One exclusion remains, tracked:
  //   - `src/host-modules.tsx` imports the virtual `host:*` modules, which plain
  //     tsc cannot resolve (TS2307) without ambient declarations that do not
  //     exist yet. Adding the file today would only redden the gate.
  //
  // `src/type-surface.tsx` is type-checked but never bundled: it holds the cases
  // that used to fail (list element types #161, `ref` on any component #162) plus
  // the shapes `keel/guest`'s own JSDoc claims compile. `src/index.tsx` stays the
  // runnable example guest that `verify.ts` executes.
  "include": ["src/index.tsx", "src/type-surface.tsx"]
}
