{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actr Realm membership",
  "description": "Realm invites, membership requests (actr-realm-membership/1), their responses and the x-actr-client-proof envelope (actr/protocols/realm-membership.md).",
  "oneOf": [
    {
      "$ref": "#/$defs/invite"
    },
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/clientProof"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "hexId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "keyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "secret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "algorithm",
        "value"
      ],
      "properties": {
        "key_id": {
          "$ref": "#/$defs/keyId"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "invite": {
      "type": "object",
      "required": [
        "schema",
        "realm",
        "secret"
      ],
      "properties": {
        "schema": {
          "const": "actr.realm-invite/v1"
        },
        "realm": {
          "type": "string"
        },
        "secret": {
          "$ref": "#/$defs/secret"
        },
        "profile": {
          "type": "object",
          "description": "Embedded Realm Profile"
        }
      },
      "additionalProperties": true
    },
    "request": {
      "type": "object",
      "required": [
        "op",
        "realm",
        "provider_id",
        "nonce",
        "issued_at",
        "expires_at",
        "signature"
      ],
      "properties": {
        "realm": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "op": {
          "enum": [
            "join",
            "create_invite",
            "revoke_invite",
            "list_members",
            "revoke_client",
            "remove_member",
            "set_role",
            "transfer_owner",
            "leave",
            "update_realm"
          ]
        },
        "invite": {
          "$ref": "#/$defs/secret"
        },
        "public_key": {
          "type": "string",
          "description": "Base64 Ed25519 public key"
        },
        "label": {
          "type": "string",
          "maxLength": 64
        },
        "role": {
          "enum": [
            "editor",
            "viewer"
          ]
        },
        "member_id": {
          "$ref": "#/$defs/hexId"
        },
        "invite_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "invite_id": {
          "$ref": "#/$defs/hexId"
        },
        "key_id": {
          "$ref": "#/$defs/keyId"
        },
        "previous_owner_role": {
          "enum": [
            "editor",
            "viewer"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "status": {
          "const": "retired"
        },
        "primary_package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "not": {
            "pattern": "[^a-z0-9-]"
          }
        },
        "front_package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "not": {
            "pattern": "[^a-z0-9-]"
          }
        },
        "packages": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
            "not": {
              "pattern": "[^a-z0-9-]"
            }
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "href",
              "sha256",
              "type"
            ],
            "properties": {
              "href": {
                "type": "string",
                "pattern": "^https://"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "type": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": true,
      "dependentRequired": {
        "primary_package": [
          "front_package",
          "packages"
        ],
        "front_package": [
          "primary_package",
          "packages"
        ],
        "packages": [
          "primary_package",
          "front_package"
        ]
      }
    },
    "clientProof": {
      "type": "object",
      "required": [
        "op",
        "realm",
        "provider_id",
        "body_sha256",
        "nonce",
        "issued_at",
        "expires_at",
        "signature"
      ],
      "properties": {
        "realm": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "op": {
          "enum": [
            "register",
            "reissue",
            "renew",
            "relay_identity"
          ]
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "joinResponse": {
      "type": "object",
      "required": [
        "realm",
        "member_id",
        "role",
        "key_id"
      ],
      "properties": {
        "realm": {
          "type": "string"
        },
        "member_id": {
          "$ref": "#/$defs/hexId"
        },
        "role": {
          "enum": [
            "owner",
            "editor",
            "viewer"
          ]
        },
        "key_id": {
          "$ref": "#/$defs/keyId"
        }
      }
    },
    "inviteResponse": {
      "type": "object",
      "required": [
        "invite_id",
        "invite",
        "expires_at"
      ],
      "properties": {
        "invite_id": {
          "$ref": "#/$defs/hexId"
        },
        "invite": {
          "type": "string",
          "pattern": "^ri_"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "membersResponse": {
      "type": "object",
      "required": [
        "realm",
        "members",
        "invites"
      ],
      "properties": {
        "realm": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "member_id",
              "role",
              "status",
              "clients"
            ],
            "properties": {
              "member_id": {
                "$ref": "#/$defs/hexId"
              },
              "role": {
                "enum": [
                  "owner",
                  "editor",
                  "viewer"
                ]
              },
              "status": {
                "enum": [
                  "active",
                  "removed"
                ]
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "removed_at": {
                "type": "string",
                "format": "date-time"
              },
              "clients": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "key_id",
                    "public_key",
                    "label"
                  ],
                  "properties": {
                    "key_id": {
                      "$ref": "#/$defs/keyId"
                    },
                    "public_key": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "registered_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "last_used_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "revoked_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "invites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "invite_id",
              "created_by",
              "expires_at"
            ],
            "properties": {
              "invite_id": {
                "$ref": "#/$defs/hexId"
              },
              "role": {
                "enum": [
                  "owner",
                  "editor",
                  "viewer"
                ]
              },
              "member_id": {
                "$ref": "#/$defs/hexId"
              },
              "created_by": {
                "type": "string"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "updateRealmResponse": {
      "type": "object",
      "required": [
        "realm",
        "sequence"
      ],
      "properties": {
        "realm": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "error",
        "message"
      ],
      "properties": {
        "error": {
          "enum": [
            "invalid_request",
            "client_unknown",
            "client_revoked",
            "member_removed",
            "forbidden",
            "realm_unavailable",
            "invite_unknown",
            "not_found",
            "invite_realm_mismatch",
            "owner_last_client",
            "owner_must_transfer",
            "conflict",
            "invite_expired",
            "invite_used",
            "invite_revoked",
            "quota",
            "unavailable"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
