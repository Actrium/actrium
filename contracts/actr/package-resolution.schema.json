{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actr Package Resolution",
  "description": "Response from an actr-packages/1 Target resolver.",
  "type": "object",
  "required": [
    "version",
    "target",
    "package"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "target": {
      "description": "The exact decoded opaque Target submitted by the client.",
      "type": "string",
      "minLength": 1
    },
    "package": {
      "$ref": "#/$defs/package"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "package": {
      "type": "object",
      "required": [
        "href",
        "media_type",
        "sha256",
        "size"
      ],
      "properties": {
        "href": {
          "description": "Absolute URL of the immutable .actr artifact.",
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "media_type": {
          "const": "application/zip"
        },
        "sha256": {
          "description": "Lowercase hexadecimal SHA-256 digest of the complete artifact bytes.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "description": "Artifact size in octets.",
          "type": "integer",
          "minimum": 1
        },
        "profile": {
          "description": "Optional workload profile hint for early Host compatibility checks.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
