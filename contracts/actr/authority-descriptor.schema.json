{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actr Authority Descriptor",
  "description": "Public service descriptor returned by GET /.well-known/actr.",
  "type": "object",
  "required": [
    "version",
    "authority",
    "services"
  ],
  "properties": {
    "version": {
      "description": "Authority descriptor format version.",
      "const": 1
    },
    "authority": {
      "description": "Canonical actr: URI of the domain, actr://<domain>, with no port, path, query, fragment, or user information.",
      "type": "string",
      "pattern": "^actr://[^@/?#:]+$"
    },
    "services": {
      "description": "Public service endpoints advertised by this authority.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/service"
      }
    },
    "realm_signing_keys": {
      "$ref": "#/$defs/realm_signing_keys"
    },
    "publisher": {
      "description": "Optional signed Publisher Profile carried inline (snake_case, schema actr.publisher/v1), verified by its own signature. 'domain' must equal the authority host. profile_signing_keys and rotations follow the rules of realm_signing_keys; package signing key ids are actr-pub-<first 16 hex of SHA-256(public key)>.",
      "type": "object",
      "required": [
        "schema",
        "domain",
        "signature"
      ],
      "properties": {
        "schema": {
          "const": "actr.publisher/v1"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "profile_signing_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/signing_key"
          }
        },
        "rotations": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/key_rotation"
          }
        },
        "keys": {
          "description": "Package signing keys; at most 2 are active.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "algorithm",
              "public_key",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^actr-pub-[0-9a-f]{16}$"
              },
              "algorithm": {
                "const": "Ed25519"
              },
              "public_key": {
                "type": "string",
                "minLength": 1
              },
              "not_before": {
                "type": "string",
                "format": "date-time"
              },
              "not_after": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "enum": [
                  "active",
                  "retired"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "signature": {
          "$ref": "#/$defs/detached_signature"
        }
      },
      "additionalProperties": true
    },
    "links": {
      "description": "Optional https path prefixes that are Realm links: https://<domain><prefix><realm_id>... corresponds to actr://<domain>/<realm_id>.... No default; clients convert only what is declared here.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/([^/?#]+/)+$"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "service": {
      "type": "object",
      "required": [
        "rel",
        "href"
      ],
      "properties": {
        "rel": {
          "description": "A core Actr service relation or an absolute URI identifying an extension relation.",
          "oneOf": [
            {
              "enum": [
                "signaling",
                "identity",
                "discovery",
                "ice-config",
                "contracts",
                "realms",
                "realm-management"
              ]
            },
            {
              "type": "string",
              "format": "uri"
            }
          ]
        },
        "href": {
          "description": "Absolute service endpoint URI.",
          "type": "string",
          "format": "uri"
        },
        "protocol": {
          "description": "Optional protocol name and major version supported by the endpoint.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "detached_signature": {
      "type": "object",
      "required": [
        "key_id",
        "algorithm",
        "value"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "realm_signing_keys": {
      "description": "Realm signing keys for Realms named <realm_id>@<domain>. Signed as a whole by an active key over the JCS form without 'signature'.",
      "type": "object",
      "required": [
        "sequence",
        "keys",
        "signature"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/signing_key"
          }
        },
        "rotations": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/key_rotation"
          }
        },
        "signature": {
          "$ref": "#/$defs/detached_signature"
        }
      },
      "additionalProperties": true
    },
    "signing_key": {
      "type": "object",
      "required": [
        "id",
        "algorithm",
        "public_key",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "public_key": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "retired"
          ]
        }
      },
      "additionalProperties": true,
      "description": "An id names one public key for the domain's whole history and is never reused. A retired key never becomes active again; removing a key revokes it."
    },
    "key_rotation": {
      "type": "object",
      "required": [
        "from",
        "to",
        "sequence",
        "signature"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "description": "Signed by the 'from' key over the JCS form of {from, to, public_key, sequence}, where public_key is that of the 'to' entry in keys and sequence is the member sequence that introduced 'to'. Entries whose 'from' or 'to' is not in keys are ignored."
    }
  }
}
