{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actr Authority Descriptor",
  "description": "Public service descriptor returned by GET /.well-known/actr.",
  "type": "object",
  "required": [
    "version",
    "authority",
    "services"
  ],
  "properties": {
    "version": {
      "description": "Authority descriptor format version.",
      "const": 1
    },
    "authority": {
      "description": "Canonical Actr authority URI with no target, query, fragment, or user information.",
      "type": "string",
      "pattern": "^actr://[^@/?#]+/?$"
    },
    "services": {
      "description": "Public service endpoints advertised by this authority.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "service": {
      "type": "object",
      "required": [
        "rel",
        "href"
      ],
      "properties": {
        "rel": {
          "description": "A core Actr service relation or an absolute URI identifying an extension relation.",
          "oneOf": [
            {
              "enum": [
                "signaling",
                "identity",
                "discovery",
                "ice-config",
                "contracts",
                "packages"
              ]
            },
            {
              "type": "string",
              "format": "uri"
            }
          ]
        },
        "href": {
          "description": "Absolute service endpoint URI.",
          "type": "string",
          "format": "uri"
        },
        "protocol": {
          "description": "Optional protocol name and major version supported by the endpoint.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
