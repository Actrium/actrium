{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actr ICE Configuration",
  "description": "Response from an actr-ice-config/1 endpoint.",
  "type": "object",
  "required": [
    "version",
    "ice_servers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "ice_servers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/iceServer"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "iceServer": {
      "type": "object",
      "required": [
        "urls"
      ],
      "properties": {
        "urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "username": {
          "type": "string"
        },
        "credential": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
