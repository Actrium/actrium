<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Unpackaged (no MSIX) so the E2E can launch the exe directly from bash. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260508005" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\bindings\cabi\csharp\ActrSharp\ActrSharp.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- actr_cabi.dll built by build-actr-cabi-dll.sh must sit next to the exe. -->
    <None Update="actr_cabi.dll" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
