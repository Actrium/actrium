<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12+ (API 31+) 系统会用 application 的主题（AppTheme）来生成 Splash Screen。
        在这里覆盖 AppTheme，将 Splash 背景设为黑色、图标设为透明，视觉上无感知。
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- 覆盖系统 Splash Screen：背景黑色 -->
        <item name="android:windowSplashScreenBackground">#000000</item>
        <!-- 图标透明，不显示任何图标 -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_transparent</item>
        <!-- 图标背景也设为黑色 -->
        <item name="android:windowSplashScreenIconBackgroundColor">#000000</item>
    </style>
</resources>
