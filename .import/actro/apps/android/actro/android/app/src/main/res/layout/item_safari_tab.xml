<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 删除按钮（仅在网格模式下显示） -->
    <LinearLayout
        android:id="@+id/llOption"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivDelete"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_delete" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="#FFFFFF" />

        <ImageView
            android:id="@+id/ivMark"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_mark" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <chat.askaway.android.tablet.ScalableContainer
            android:id="@+id/flAppContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- ReactRootView 会动态添加到这里 -->

            <!-- 标题和 URL 显示在最上层（仅在 Grid 模式下显示） -->
            <LinearLayout
                android:id="@+id/llInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#80000000"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Title"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="https://example.com"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp" />

            </LinearLayout>

        </chat.askaway.android.tablet.ScalableContainer>

        <!-- Grid 模式下显示的截图 ImageView，覆盖在 ReactRootView 之上 -->
        <ImageView
            android:id="@+id/ivScreenshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitStart"
            android:background="#F00"
            android:visibility="gone" />

        </androidx.cardview.widget.CardView>

</LinearLayout>