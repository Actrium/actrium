#!/bin/bash -eu
#
# 辅助脚本

show_error() {
  echo -e "[$(date +'%Y-%m-%dT%H:%M:%S%z')] \033[31m{$*}\033[0m" >&2
  exit 1
}

# 修改 iOS 工程中的硬编码配置（BrowserViewModel 中的 counterAppDevPath）
update_ios_config() {
  local viewmodel_file="Actro/Views/MainContentView/BrowserViewModel.swift"
  
  if [[ ! -f "$viewmodel_file" ]]; then
    show_error "找不到文件: $viewmodel_file"
  fi
  
  # 获取项目根目录（脚本所在目录）的绝对路径
  local project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local abs_path="$project_root/ActroRuntime/actr-app-examples/counterapp"
  
  # 验证目标路径是否存在
  if [[ ! -d "$abs_path" ]]; then
    show_error "目标路径不存在: $abs_path"
  fi
  
  # 使用 sed 替换 counterAppDevPath 的值
  sed -i '' "s|let counterAppDevPath = \".*\"|let counterAppDevPath = \"$abs_path\"|g" "$viewmodel_file"
  
  echo "✅ 已更新 counterAppDevPath 为: $abs_path"
}

# 修改 .xcode.env.local 文件中的配置项（NODE_BINARY 路径）
update_xcode_env() {
  local env_file=".xcode.env.local"
  local node_path="${1:-$(which node)}"
  
  if [[ ! -f "$node_path" ]]; then
    show_error "Node 可执行文件不存在: $node_path"
  fi
  
  # 如果文件不存在，创建它
  if [[ ! -f "$env_file" ]]; then
    echo "export NODE_BINARY=$node_path" > "$env_file"
    echo "✅ 已创建 $env_file 并设置 NODE_BINARY=$node_path"
  else
    # 检查是否已有 NODE_BINARY 配置
    if grep -q "^export NODE_BINARY=" "$env_file"; then
      sed -i '' "s|^export NODE_BINARY=.*|export NODE_BINARY=$node_path|g" "$env_file"
      echo "✅ 已更新 NODE_BINARY 为: $node_path"
    else
      echo "export NODE_BINARY=$node_path" >> "$env_file"
      echo "✅ 已添加 NODE_BINARY=$node_path 到 $env_file"
    fi
  fi
}

# 便捷启动器
main() {
  case $1 in
  're') # 从新安装 RN 的依赖库（同时更新配置）
    # update_ios_config
    # update_xcode_env
    ./Scripts/reinstall-dependencies.sh
    ;;
  
  'config') # 更新 BrowserViewModel 中的开发路径
    update_ios_config
    ;;
  
  'node') # 更新 .xcode.env.local 中的 Node 路径
    shift
    update_xcode_env "$@"
    ;;

  'tf') # 打包并上传到 TestFlight
    ./Scripts/upload-testflight.sh
    ;;

  'pkg') # 调试构建
    ./Scripts/test-build.sh pkg
    ;;

  'pkg-prd') # 正式构建
    ./Scripts/test-build.sh pkg-prd
    ;;

  *) show_error "无效命令: $*" ;;
  esac
}

main "$@"
