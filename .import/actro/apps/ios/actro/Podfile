actro_runtime_path = File.join(__dir__, 'ActroRuntime')
# Keep react-native path RELATIVE. RN CocoaPods helpers assume `path` is relative and will
# incorrectly prefix it if an absolute path is passed (leading to paths like "./Users/..." or "../Users/...").
react_native_path = 'ActroRuntime/node_modules/react-native'

# 设置 NODE_PATH 环境变量，使 Node.js 能够找到 ActroRuntime 下的 node_modules
ENV['NODE_PATH'] = File.join(__dir__, 'ActroRuntime', 'node_modules')

# 在这里设置禁用标志
# 禁用 VisionCamera 与 worklets（帧处理器）的关联
$VCEnableFrameProcessors = false 

# Require react_native_pods via a stable absolute path.
require File.join(actro_runtime_path, 'node_modules', 'react-native', 'scripts', 'react_native_pods')
# react-native-permissions setup 脚本
require File.join(actro_runtime_path, 'node_modules', 'react-native-permissions', 'scripts', 'setup')

prepare_react_native_project!

# 只编译通知权限模块
setup_permissions([
  'Notifications',
])

target 'Actro' do
  platform :ios, '17.0'

  # 自动链接原生模块 (暂时手动添加以解决项目结构导致的路径问题)
  # use_native_modules!
  pod 'RNLocalize', :path => 'ActroRuntime/node_modules/react-native-localize'
  pod 'react-native-safe-area-context', :path => 'ActroRuntime/node_modules/react-native-safe-area-context'
  pod 'react-native-sqlite-storage', :path => 'ActroRuntime/node_modules/react-native-sqlite-storage'
  pod 'VisionCamera', :path => 'ActroRuntime/node_modules/react-native-vision-camera'
  pod 'react-native-image-picker', :path => 'ActroRuntime/node_modules/react-native-image-picker'
  pod 'react-native-document-picker', :path => 'ActroRuntime/node_modules/@react-native-documents/picker'
  pod 'react-native-maps', :path => 'ActroRuntime/node_modules/react-native-maps'
  pod 'react-native-geolocation', :path => 'ActroRuntime/node_modules/@react-native-community/geolocation'
  pod 'react-native-netinfo', :path => 'ActroRuntime/node_modules/@react-native-community/netinfo'
  pod 'react-native-image-resizer', :path => 'ActroRuntime/node_modules/@bam.tech/react-native-image-resizer'
  pod 'BVLinearGradient', :path => 'ActroRuntime/node_modules/react-native-linear-gradient'
  pod 'NitroSound', :path => 'ActroRuntime/node_modules/react-native-nitro-sound'
  pod 'NitroModules', :path => 'ActroRuntime/node_modules/react-native-nitro-modules'
  pod 'RNCClipboard', :path => 'ActroRuntime/node_modules/@react-native-clipboard/clipboard'
  pod 'RNFS', :path => 'ActroRuntime/node_modules/react-native-fs'
  pod 'RNZipArchive', :path => 'ActroRuntime/node_modules/react-native-zip-archive'
  pod 'RNLiveAudioStream', :path => 'ActroRuntime/node_modules/react-native-live-audio-stream'
  pod 'RNDeviceInfo', :path => 'ActroRuntime/node_modules/react-native-device-info'
  pod 'react-native-get-random-values', :path => 'ActroRuntime/node_modules/react-native-get-random-values'
  pod 'react-native-webview', :path => 'ActroRuntime/node_modules/react-native-webview'
  pod 'react-native-view-shot', :path => 'ActroRuntime/node_modules/react-native-view-shot'
  pod 'react-native-cameraroll', :path => 'ActroRuntime/node_modules/@react-native-camera-roll/camera-roll'
  pod 'RNGestureHandler', :path => 'ActroRuntime/node_modules/react-native-gesture-handler'
  pod 'RNReanimated', :path => 'ActroRuntime/node_modules/react-native-reanimated'
  pod 'RNSVG', :path => 'ActroRuntime/node_modules/react-native-svg'
  pod 'react-native-keyboard-controller', :path => 'ActroRuntime/node_modules/react-native-keyboard-controller'
  pod 'RNReactNativeHapticFeedback', :path => 'ActroRuntime/node_modules/react-native-haptic-feedback'
  pod 'ExpoSpeechRecognition', :path => 'ActroRuntime/node_modules/@boomsi/rn-speech-recognition/ios'
  pod 'SupramarkMarkdownNative', :path => 'ActroRuntime/node_modules/@supramark/markdown-native-rn'
  pod 'SupramarkD2Native', :path => 'ActroRuntime/node_modules/@actrium/supramark-d2-native-rn'
  pod 'SupramarkMermaidNative', :path => 'ActroRuntime/node_modules/@actrium/supramark-mermaid-native-rn'
  pod 'SupramarkPlantumlNative', :path => 'ActroRuntime/node_modules/@actrium/supramark-plantuml-native-rn'

  # react-native-permissions 核心库（通知权限处理器由 setup_permissions 自动挂载）
  pod 'RNPermissions', :path => 'ActroRuntime/node_modules/react-native-permissions'
  # pod 'react-native-worklets-core', :path => 'ActroRuntime/node_modules/react-native-worklets-core'

  # 微信 SDK
  pod 'WechatOpenSDK-XCFramework'

  # 强制使用旧架构（Bridge模式）
  ENV['RCT_NEW_ARCH_ENABLED'] = '0'  # 或者完全不设置这个变量

  use_react_native!(
    path: react_native_path,
    hermes_enabled: false,
    fabric_enabled: false,
    # React Native JS 工程所在目录（包含 package.json）
    app_path: actro_runtime_path
  )

  # rill native sandbox (JSI)
  pod 'RillSandboxNative', :path => 'ActroRuntime/node_modules/rill'

  post_install do |installer|
    # 告诉 React Native 正确的源码位置，避免 Codegen 误报
    react_native_post_install(installer, react_native_path)

    # 抑制所有 Pods 项目的警告
    installer.pods_project.targets.each do |target|
      target.shell_script_build_phases.each do |phase|
        next unless phase.name&.start_with?('[CP-User] [RN]Check ')

        stamp_name = phase.name
          .downcase
          .gsub(/^\[cp-user\]\s*/, '')
          .gsub(/[^a-z0-9]+/, '-')
          .gsub(/^-|-$/, '')
        phase.output_paths = ["$(DERIVED_FILE_DIR)/#{target.name}-#{stamp_name}-$(CONFIGURATION).stamp"]
        phase.shell_script = "#{phase.shell_script}\nmkdir -p \"${DERIVED_FILE_DIR}\"\ntouch \"${SCRIPT_OUTPUT_FILE_0}\"\n"
        phase.always_out_of_date = nil if phase.respond_to?(:always_out_of_date=)
      end

      target.build_configurations.each do |config|
        # 抑制所有警告
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
        config.build_settings['OTHER_LIBTOOLFLAGS'] = '$(inherited) -no_warning_for_no_symbols'
        # 抑制特定的常见警告
        config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
        config.build_settings['CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF'] = 'NO'
        config.build_settings['GCC_WARN_64_TO_32_BIT_CONVERSION'] = 'NO'
        if target.name == 'fmt'
          # Xcode 26's C++20 consteval checks reject fmt's FMT_STRING uses in format.cc.
          # Building fmt itself as C++17 keeps RN pods on C++20 while avoiding the mismatch.
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end

    # Xcode 26 may set TOOLCHAIN_DIR to the Metal toolchain for parts of the build.
    # Keep Swift stdlib search paths anchored to the default Xcode toolchain.
    Dir.glob(File.join(__dir__, 'Pods', 'Target Support Files', 'Pods-Actro', 'Pods-Actro.*.xcconfig')).each do |xcconfig|
      contents = File.read(xcconfig)
      updated = contents.gsub('${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}', '${DT_TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}')
      File.write(xcconfig, updated) if updated != contents
    end
  end
end
