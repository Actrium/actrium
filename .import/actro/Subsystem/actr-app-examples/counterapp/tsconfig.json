{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "rill/let": ["../../../../rill/src/sdk/index.ts"],
      "rill/sdk": ["../../../../rill/src/sdk/index.ts"],
      "askit": ["../../../askit/src/index.ts"]
    }
  },
  "include": ["entry.ts", "src/**/*"],
  "exclude": ["**/node_modules/**", "**/rill/src/guest/reconciler/**"]
}
