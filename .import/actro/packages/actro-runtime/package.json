  "description": "Actro React Native runtime for actr apps and system apps",
  "main": "index.ts",
  "scripts": {
    "start": "node node_modules/react-native/cli.js start --verbose --reset-cache",
    "log": "bun log-server.ts",
    "dev": "node scripts/dev-start.js",
    "generate:actro-core-contract": "cargo run -p actro-core --bin generate-ts-contracts -- src/actr-host/generated/actroCoreContract.ts",
    "generate:actr:signature": "node scripts/generate-actr-signature.js",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:all": "tsc --noEmit",
    "lint:logs": "node scripts/check-logs.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "patch-package && node scripts/patch-react-native-macos.js",
    "prepare": "husky"
  },
