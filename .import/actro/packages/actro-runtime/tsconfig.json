{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["react", "react-native", "node"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react-native": ["./node_modules/react-native/types/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "askit": ["../askit/src/index.host.ts"],
      "askit/core": ["../askit/src/core/index.ts"],
      "askit/contracts": ["../askit/src/contracts/index.ts"],
      "rill": ["../rill/src/host/index.ts"]
    }
  },
  "include": ["index.ts", "src"],
  "exclude": ["node_modules", "../rill/src/guest", "../rill/src/cli", "../rill/src/sandbox", "../rill/src/devtools"]
}
