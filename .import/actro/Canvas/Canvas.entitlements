<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Groups for XPC Broker -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.chat.askaway.canvas</string>
	</array>

	<!-- App Sandbox -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	
	<!-- Network Access -->
	<key>com.apple.security.network.client</key>
	<true/>
	
	<key>com.apple.security.network.server</key>
	<true/>
	
	<!-- Allow JIT Compilation (Required for WebKit JavaScript) -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	
	<!-- Allow Unsigned Executable Memory (Alternative for older macOS) -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	
	<!-- Disable Library Validation (Required for WebKit) -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
