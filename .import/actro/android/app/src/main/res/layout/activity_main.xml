<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="false">

    <FrameLayout
        android:id="@+id/flContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/flBookmark"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/llActive"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <!-- 标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AskAway"
                    android:textColor="@android:color/white"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/ivAdd"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/primary_circle"
                    android:padding="12dp"
                    android:src="@drawable/ic_add" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/flSet"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 导航栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="95dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bottom_nav_gradient"
            android:orientation="horizontal"
            android:paddingTop="12dp">

            <FrameLayout
                android:layout_width="252dp"
                android:layout_height="62dp"
                android:layout_gravity="center_horizontal|top"
                android:background="@drawable/bottom_nav_bg">

                <!-- 滑动背景 -->
                <FrameLayout
                    android:id="@+id/flNavIndicator"
                    android:layout_width="92dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bottom_nav_indicator" />

                <!-- 导航项容器 -->
                <RadioGroup
                    android:id="@+id/rgNavigation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <!-- 标签页 -->
                    <RadioButton
                        android:id="@+id/navTag"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@null"
                        android:checked="true"
                        android:drawableTop="@drawable/nav_tag_selector"
                        android:drawablePadding="4dp"
                        android:drawableTint="@color/nav_text_selector"
                        android:gravity="center"
                        android:text="@string/tab_bookmark"
                        android:textColor="@color/nav_text_selector"
                        android:textSize="10sp" />

                    <!-- 活动页 -->
                    <RadioButton
                        android:id="@+id/navActivity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@null"
                        android:drawableTop="@drawable/nav_activity_selector"
                        android:drawablePadding="4dp"
                        android:drawableTint="@color/nav_text_selector"
                        android:gravity="center"
                        android:text="@string/tab_active"
                        android:textColor="@color/nav_text_selector"
                        android:textSize="10sp" />

                    <!-- 设置页 -->
                    <RadioButton
                        android:id="@+id/navSettings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@null"
                        android:drawableTop="@drawable/nav_settings_selector"
                        android:drawablePadding="4dp"
                        android:drawableTint="@color/nav_text_selector"
                        android:gravity="center"
                        android:text="@string/tab_set"
                        android:textColor="@color/nav_text_selector"
                        android:textSize="10sp" />
                </RadioGroup>
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bottom_nav_bg"
                android:padding="20dp"
                android:src="@drawable/ic_search"
                android:tint="@color/labels_vibrant_controls_primary" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/flReactNative"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/react_native_bg">

        <FrameLayout
            android:id="@+id/flRNContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/flSearch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>