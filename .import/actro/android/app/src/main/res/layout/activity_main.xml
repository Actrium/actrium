<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="false">

    <FrameLayout
        android:id="@+id/flContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/flBookmark"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 空白视图 - 放在 flContent 内，与 llActive 同级，实现全屏居中 -->
        <LinearLayout
            android:id="@+id/llEmptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="71dp"
                android:layout_height="71dp"
                android:src="@drawable/active_empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="25dp"
                android:text="@string/active_empty_text"
                android:textColor="#565656"
                android:textSize="20sp"
                android:lineHeight="30dp"
                android:includeFontPadding="false"
                android:gravity="center" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/llActive"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="80dp"
                android:paddingBottom="100dp" />

            <!-- 标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/top_gradient"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AskAway"
                    android:textColor="@android:color/white"
                    android:textSize="34sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/ivAdd"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/primary_circle"
                    android:padding="12dp"
                    android:src="@drawable/ic_add" />

            </LinearLayout>


        </FrameLayout>

        <FrameLayout
            android:id="@+id/flSet"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/flSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="false"
            android:focusableInTouchMode="true"
            android:visibility="gone" />

        <!-- 导航栏 -->
        <FrameLayout
            android:id="@+id/flNavBar"
            android:layout_width="match_parent"
            android:layout_height="95dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:paddingTop="12dp">

            <LinearLayout
                android:id="@+id/llNav"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="252dp"
                    android:layout_height="62dp"
                    android:layout_gravity="center_horizontal|top"
                    android:background="@drawable/bottom_nav_bg">

                    <!-- 滑动背景 -->
                    <FrameLayout
                        android:id="@+id/flNavIndicator"
                        android:layout_width="92dp"
                        android:layout_height="58dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bottom_nav_indicator" />

                    <!-- 导航项容器 -->
                    <RadioGroup
                        android:id="@+id/rgNavigation"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <!-- 标签页 -->
                        <RadioButton
                            android:id="@+id/navTag"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:button="@null"
                            android:checked="true"
                            android:drawableTop="@drawable/nav_tag_selector"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/nav_text_selector"
                            android:gravity="center"
                            android:text="@string/tab_bookmark"
                            android:textColor="@color/nav_text_selector"
                            android:textSize="10sp" />

                        <!-- 活动页 -->
                        <RadioButton
                            android:id="@+id/navActivity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:button="@null"
                            android:drawableTop="@drawable/nav_activity_selector"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/nav_text_selector"
                            android:gravity="center"
                            android:text="@string/tab_active"
                            android:textColor="@color/nav_text_selector"
                            android:textSize="10sp" />

                        <!-- 设置页 -->
                        <RadioButton
                            android:id="@+id/navSettings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:button="@null"
                            android:drawableTop="@drawable/nav_settings_selector"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/nav_text_selector"
                            android:gravity="center"
                            android:text="@string/tab_set"
                            android:textColor="@color/nav_text_selector"
                            android:textSize="10sp" />
                    </RadioGroup>
                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/ivSearch"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bottom_nav_bg"
                    android:padding="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/labels_vibrant_controls_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llSearchMode"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/flNavButton"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bottom_nav_bg">

                    <RadioButton
                        android:id="@+id/ivNav"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:button="@null"
                        android:clickable="false"
                        android:checked="false"
                        android:drawableTop="@drawable/nav_activity_selector"
                        android:drawablePadding="4dp"
                        android:drawableTint="@color/labels_vibrant_controls_primary"
                        android:gravity="center"
                        android:text="@string/tab_active"
                        android:textColor="@color/labels_vibrant_controls_primary"
                        android:textSize="10sp" />
                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/llEdit"
                    android:layout_width="252dp"
                    android:layout_height="62dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bottom_nav_bg"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivSearchIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/labels_vibrant_controls_primary" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:hint="@string/search"
                        android:paddingStart="8dp"
                        android:layout_height="62dp"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:background="@android:color/transparent" />

                    <ImageView
                        android:id="@+id/ivDel"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_delete"
                        android:visibility="gone"
                        app:tint="#000" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/flReactNative"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/react_native_bg"
        android:fitsSystemWindows="false"
        android:focusableInTouchMode="true">

        <FrameLayout
            android:id="@+id/flRNContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</FrameLayout>