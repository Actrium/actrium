rctnapps_path = File.join(__dir__, 'RCTNApps')
# Keep react-native-macos path RELATIVE. RN CocoaPods helpers assume `path` is relative and will
# incorrectly prefix it if an absolute path is passed (leading to paths like "./Users/..." or "../Users/...").
react_native_macos_path = 'RCTNApps/node_modules/react-native-macos'

# Require react_native_pods via a stable absolute path.
require File.join(rctnapps_path, 'node_modules', 'react-native-macos', 'scripts', 'react_native_pods')

prepare_react_native_project!

# Shared React Native configuration
def use_canvas_react_native
  # 根据环境变量决定是否启用新架构 / Fabric
  flags = get_default_flags()

  use_react_native!(
    path: 'RCTNApps/node_modules/react-native-macos',
    hermes_enabled: false,
    fabric_enabled: ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    # React Native JS 工程所在目录（包含 package.json）
    app_path: File.join(__dir__, 'RCTNApps')
  )

  # rill native sandbox (JSI)
  # pod 'RillSandboxNative', :path => 'RCTNApps/node_modules/rill/native/platform'
end

target 'Canvas' do
  platform :macos, '14.0'
  use_canvas_react_native
end

# ViewBridge XPC service with React Native
target 'CanvasViewService' do
  platform :macos, '14.0'
  use_canvas_react_native
end

post_install do |installer|
  # 告诉 React Native 正确的源码位置，避免 Codegen 误报
  react_native_post_install(installer, react_native_macos_path)

  # 抑制所有 Pods 项目的警告
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # 抑制所有警告
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      # 抑制特定的常见警告
      config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
      config.build_settings['CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF'] = 'NO'
      config.build_settings['GCC_WARN_64_TO_32_BIT_CONVERSION'] = 'NO'
    end
  end
end
