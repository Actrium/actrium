subsystem_path = File.join(__dir__, 'Subsystem')
# Keep react-native path RELATIVE. RN CocoaPods helpers assume `path` is relative and will
# incorrectly prefix it if an absolute path is passed (leading to paths like "./Users/..." or "../Users/...").
react_native_path = 'Subsystem/node_modules/react-native'

# 设置 NODE_PATH 环境变量，使 Node.js 能够找到 Subsystem 下的 node_modules
ENV['NODE_PATH'] = File.join(__dir__, 'Subsystem', 'node_modules')

# 在这里设置禁用标志
# 禁用 VisionCamera 与 worklets（帧处理器）的关联
$VCEnableFrameProcessors = false 

# Require react_native_pods via a stable absolute path.
require File.join(subsystem_path, 'node_modules', 'react-native', 'scripts', 'react_native_pods')
# react-native-permissions setup 脚本
require File.join(subsystem_path, 'node_modules', 'react-native-permissions', 'scripts', 'setup')

prepare_react_native_project!

# 只编译通知权限模块
setup_permissions([
  'Notifications',
])

target 'Canvas' do
  platform :ios, '17.0'

  # 自动链接原生模块 (暂时手动添加以解决项目结构导致的路径问题)
  # use_native_modules!
  pod 'RNLocalize', :path => 'Subsystem/node_modules/react-native-localize'
  pod 'react-native-safe-area-context', :path => 'Subsystem/node_modules/react-native-safe-area-context'
  pod 'react-native-sqlite-storage', :path => 'Subsystem/node_modules/react-native-sqlite-storage'
  pod 'VisionCamera', :path => 'Subsystem/node_modules/react-native-vision-camera'
  pod 'react-native-image-picker', :path => 'Subsystem/node_modules/react-native-image-picker'
  pod 'react-native-document-picker', :path => 'Subsystem/node_modules/@react-native-documents/picker'
  pod 'react-native-maps', :path => 'Subsystem/node_modules/react-native-maps'
  pod 'react-native-geolocation', :path => 'Subsystem/node_modules/@react-native-community/geolocation'
  pod 'react-native-netinfo', :path => 'Subsystem/node_modules/@react-native-community/netinfo'
  pod 'react-native-image-resizer', :path => 'Subsystem/node_modules/@bam.tech/react-native-image-resizer'
  pod 'BVLinearGradient', :path => 'Subsystem/node_modules/react-native-linear-gradient'
  pod 'NitroSound', :path => 'Subsystem/node_modules/react-native-nitro-sound'
  pod 'NitroModules', :path => 'Subsystem/node_modules/react-native-nitro-modules'
  pod 'RNCClipboard', :path => 'Subsystem/node_modules/@react-native-clipboard/clipboard'
  pod 'RNFS', :path => 'Subsystem/node_modules/react-native-fs'
  pod 'RNZipArchive', :path => 'Subsystem/node_modules/react-native-zip-archive'
  pod 'RNLiveAudioStream', :path => 'Subsystem/node_modules/react-native-live-audio-stream'
  pod 'RNDeviceInfo', :path => 'Subsystem/node_modules/react-native-device-info'
  pod 'react-native-get-random-values', :path => 'Subsystem/node_modules/react-native-get-random-values'
  pod 'react-native-webview', :path => 'Subsystem/node_modules/react-native-webview'
  pod 'react-native-view-shot', :path => 'Subsystem/node_modules/react-native-view-shot'
  pod 'react-native-cameraroll', :path => 'Subsystem/node_modules/@react-native-camera-roll/camera-roll'
  pod 'RNGestureHandler', :path => 'Subsystem/node_modules/react-native-gesture-handler'
  pod 'RNReanimated', :path => 'Subsystem/node_modules/react-native-reanimated'
  pod 'RNSVG', :path => 'Subsystem/node_modules/react-native-svg'
  pod 'react-native-keyboard-controller', :path => 'Subsystem/node_modules/react-native-keyboard-controller'
  pod 'RNReactNativeHapticFeedback', :path => 'Subsystem/node_modules/react-native-haptic-feedback'
  pod 'ExpoSpeechRecognition', :path => 'Subsystem/node_modules/@boomsi/rn-speech-recognition/ios'

  # react-native-permissions 核心库（通知权限处理器由 setup_permissions 自动挂载）
  pod 'RNPermissions', :path => 'Subsystem/node_modules/react-native-permissions'
  # pod 'react-native-worklets-core', :path => 'Subsystem/node_modules/react-native-worklets-core'

  # 微信 SDK
  pod 'WechatOpenSDK-XCFramework'

  # 强制使用旧架构（Bridge模式）
  ENV['RCT_NEW_ARCH_ENABLED'] = '0'  # 或者完全不设置这个变量

  use_react_native!(
    path: react_native_path,
    hermes_enabled: false,
    fabric_enabled: false,
    # React Native JS 工程所在目录（包含 package.json）
    app_path: subsystem_path
  )

  # rill native sandbox (JSI)
  pod 'RillSandboxNative', :path => 'Subsystem/node_modules/rill/native/platform'
  # pod 'RillSandboxNative', :path => 'Subsystem/node_modules/rill/native'

  post_install do |installer|
    # 告诉 React Native 正确的源码位置，避免 Codegen 误报
    react_native_post_install(installer, react_native_path)

    # 抑制所有 Pods 项目的警告
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # 抑制所有警告
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        # 抑制特定的常见警告
        config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
        config.build_settings['CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF'] = 'NO'
        config.build_settings['GCC_WARN_64_TO_32_BIT_CONVERSION'] = 'NO'
      end
    end
  end
end
