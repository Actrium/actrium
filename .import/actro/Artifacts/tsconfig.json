{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["react", "react-native"],
    "noEmit": true,
    "strict": true,
    "baseUrl": ".",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react-native": ["./node_modules/@types/react-native/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "askit": ["../../askit/src/index.host.ts"],
      "askit/core": ["../../askit/src/core/index.ts"],
      "askit/contracts": ["../../askit/src/contracts/index.ts"]
    }
  },
  "include": ["index.ts", "src"]
}
