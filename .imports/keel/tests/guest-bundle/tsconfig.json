{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["react"],
    "baseUrl": ".",
    "paths": {
      "rill/guest": ["../../src/sdk/index.ts"],
      "rill/contract": ["../../src/contract/index.ts"],
      "rill/*": ["../../src/*"]
    }
  },
  "include": ["src/index.tsx"]
}
