edition = 1
exports = []

[package]
name = "echo-client-app"
publisher = "{{PUBLISHER}}"
description = "Actor-RTC TypeScript echo app"
authors = []
license = "Apache-2.0"
tags = ["dev", "service"]

[dependencies]
{{#if IS_BOTH}}
EchoService = { actr_type = "{{PUBLISHER}}/EchoService@1.0.0" }
{{else}}
EchoService = { actr_type = "{{PUBLISHER}}/EchoService@1.0.0" }
{{/if}}

[system.signaling]
url = "{{{SIGNALING_URL}}}/signaling/ws"

[system.issuer_endpoint]
url = "{{{ISSUER_ENDPOINT_URL}}}"

[system.deployment]
realm = "{{REALM}}"

[system.discovery]
visible = true

[system.observability]
filter_level = "info"
tracing_enabled = false
tracing_endpoint = "http://127.0.0.1:4317"
tracing_service_name = "{{PROJECT_NAME}}"

[system.webrtc]
force_relay = false
stun_urls = {{{STUN_URLS}}}
turn_urls = {{{TURN_URLS}}}

[scripts]
dev = "npm run dev"

[acl]

[[acl.rules]]
permission = "allow"
type = "{{PUBLISHER}}/EchoService@1.0.0"
